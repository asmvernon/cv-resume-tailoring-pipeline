#!/bin/sh
# Block commits made directly on main. Use a feature branch + PR instead.

branch=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$branch" = "main" ]; then
    echo "Error: direct commits to 'main' are blocked." >&2
    echo "Create a feature branch instead, e.g.:" >&2
    echo "  git checkout -b my-change" >&2
    exit 1
fi
